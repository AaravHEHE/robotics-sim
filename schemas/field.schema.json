{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "field.schema.json",
  "title": "VEX auton simulator field definition",
  "description": "Inches, origin at the field center, +y away from the near wall, headings clockwise from +y. Validated by src/sim/field.ts.",
  "type": "object",
  "required": ["schema", "id", "name", "perimeter", "tiles", "objects", "game"],
  "properties": {
    "schema": { "const": 1 },
    "id": { "type": "string" },
    "name": { "type": "string" },
    "perimeter": {
      "type": "object",
      "required": ["inside", "wallHeight", "wallThickness"],
      "properties": {
        "inside": { "type": "number", "description": "Inside wall-to-wall distance (VEX spec: 140.5 in +/- 0.5)" },
        "wallHeight": { "type": "number" },
        "wallThickness": { "type": "number" }
      }
    },
    "tiles": {
      "type": "object",
      "required": ["count", "color", "lineColor"],
      "properties": { "count": { "type": "integer", "minimum": 1 }, "color": { "type": "string" }, "lineColor": { "type": "string" } }
    },
    "objects": {
      "type": "array",
      "description": "Static field elements (reserved for game-specific fields)",
      "items": {
        "type": "object",
        "required": ["id", "shape", "height"],
        "properties": {
          "id": { "type": "string" },
          "shape": { "type": "object" },
          "height": { "type": "number" },
          "color": { "type": "string" },
          "movable": { "type": "boolean" }
        }
      }
    },
    "goals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "color", "x", "y", "height", "baseWidth", "topWidth", "bodyHeight", "socket", "zone"],
        "properties": {
          "id": { "type": "string" }, "kind": { "enum": ["alliance", "neutral", "center"] }, "color": { "enum": ["red", "blue", "neutral"] },
          "x": { "type": "number" }, "y": { "type": "number" }, "height": { "type": "number" }, "baseWidth": { "type": "number" },
          "topWidth": { "type": "number" }, "bodyHeight": { "type": "number" }, "socket": { "type": "number" }, "zone": { "type": "string" },
          "aprilTag": { "type": "integer" }
        }
      }
    },
    "toggles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "wall", "x", "y", "length", "sectionHeight", "topHeight", "zone", "start"],
        "properties": {
          "wall": { "enum": ["left", "right", "top", "bottom"] },
          "start": { "type": "object", "required": ["in", "out", "down"], "description": "Face colors at the start: into the field, out of the field, down on the mounts" }
        }
      }
    },
    "loaders": { "type": "array", "items": { "type": "object", "required": ["id", "alliance", "x", "y", "wall", "width", "depth", "height", "opening"] } },
    "zones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "name", "color", "polygon"],
        "properties": { "kind": { "enum": ["quadrant", "midfield", "loadZone"] }, "polygon": { "type": "array", "items": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 } } }
      }
    },
    "tape": { "type": "array", "items": { "type": "object", "required": ["from", "to", "width", "color"] } },
    "layouts": {
      "type": "object",
      "description": "Starting layouts by mode: h2h (Head-to-Head) and skills (Robot Skills)",
      "additionalProperties": {
        "type": "object",
        "required": ["name", "items"],
        "properties": {
          "items": { "type": "array", "description": "{type: stack|lying|goal, ...}; stacks list pieces bottom first" },
          "matchLoads": { "type": "object" },
          "preload": { "type": "object" }
        }
      }
    },
    "startPositions": {
      "type": "array",
      "items": { "type": "object", "required": ["id", "name", "alliance", "zone", "x", "y", "theta", "layouts"] }
    },
    "game": { "oneOf": [{ "type": "null" }, { "type": "object", "required": ["id"], "properties": { "id": { "type": "string" } } }] },
    "sources": { "type": "array", "items": { "type": "string" } }
  }
}
