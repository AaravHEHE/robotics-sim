    "width": 15,
    "length": 15,
    "height": 11
  },
  "mass": 13,
  "drivetrain": {
    "type": "tank",
    "left": [
      -1,
      -2,
      -3
    ],
    "right": [
      4,
      5,
      6
    ],
    "cartridge": "blue",
    "wheelDiameter": 3.25,
    "wheelRpm": 450,
    "trackWidth": 11.5,
    "maxAccel": 180
  },
  "devices": [
    {
      "type": "imu",
      "port": 11,
      "name": "IMU"
    },
    {
      "type": "motor",
      "port": 8,
